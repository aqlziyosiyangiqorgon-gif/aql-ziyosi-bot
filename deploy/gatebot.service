[Unit]
Description=AQL ZIYOSI Gatekeeper Telegram Bot
After=network.target

[Service]
Type=simple
User=gatebot
WorkingDirectory=/opt/gatebot
EnvironmentFile=/opt/gatebot/.env
ExecStart=/opt/gatebot/.venv/bin/python -m gatebot.main
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
